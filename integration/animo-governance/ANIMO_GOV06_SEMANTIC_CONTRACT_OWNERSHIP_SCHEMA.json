{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ANIMO_GOV06_SEMANTIC_CONTRACT_OWNERSHIP_SCHEMA_v1",
  "title":"ANIMO5 semantic contract ownership declaration",
  "type":"object",
  "additionalProperties":false,
  "required":["workunit","consumed_contracts","owned_modified_contracts","allowed_scope","forbidden_overlap","dependencies","parallelism_class","exit_gate"],
  "properties":{
    "workunit":{"type":"string","minLength":1},
    "consumed_contracts":{"type":"array","items":{"$ref":"#/$defs/contract"}},
    "owned_modified_contracts":{"type":"array","items":{"$ref":"#/$defs/contract"}},
    "allowed_scope":{"type":"array","items":{"type":"string"},"minItems":1},
    "forbidden_overlap":{"type":"array","items":{"type":"string"}},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "parallelism_class":{"enum":["SAFE_PARALLEL","PARALLEL_AFTER_PINNING","SERIAL_REQUIRED"]},
    "exit_gate":{"type":"string","minLength":1}
  },
  "$defs":{"contract":{"type":"object","additionalProperties":false,"required":["id","stability","owner","authority"],"properties":{"id":{"type":"string","minLength":1},"stability":{"enum":["FROZEN","MOVING"]},"owner":{"type":"string","minLength":1},"authority":{"type":"string","minLength":1}}}}
}
