{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GOV05_INTERNAL_ADVERSARIAL_REVIEW_SCHEMA.json",
  "title": "ANIMO GOV05 internal adversarial review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_unit",
    "review_mode",
    "assurance_label",
    "reviewed_authoring_head",
    "same_agent",
    "independence_claimed",
    "review_boundary",
    "evidence_reuse_checks",
    "adversarial_gates",
    "residual_uncertainty",
    "outcome"
  ],
  "properties": {
    "work_unit": {"type": "string", "minLength": 1},
    "review_mode": {
      "type": "string",
      "enum": ["INTERNAL_ADVERSARIAL_REVIEW", "SAME_AGENT_SECOND_PASS"]
    },
    "assurance_label": {
      "type": "string",
      "enum": [
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT",
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_LOWER_THAN_GOV04_SEPARATE_CONTEXT",
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_MULTI_SURFACE"
      ]
    },
    "reviewed_authoring_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "same_agent": {"const": true},
    "independence_claimed": {"const": false},
    "review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_authoring_package_persisted",
        "immutable_head_frozen_before_review",
        "source_testbank_evidence_hashes_recorded_before_review",
        "authoring_completed_before_review",
        "moving_tree_reviewed"
      ],
      "properties": {
        "complete_authoring_package_persisted": {"const": true},
        "immutable_head_frozen_before_review": {"const": true},
        "source_testbank_evidence_hashes_recorded_before_review": {"const": true},
        "authoring_completed_before_review": {"const": true},
        "moving_tree_reviewed": {"const": false}
      }
    },
    "evidence_reuse_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin_identity", "scope_compatibility", "no_superseding_contradiction", "evidence_strength_preserved"],
      "properties": {
        "pin_identity": {"const": "PASS"},
        "scope_compatibility": {"const": "PASS"},
        "no_superseding_contradiction": {"const": "PASS"},
        "evidence_strength_preserved": {"const": "PASS"}
      }
    },
    "adversarial_gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]
      }
    },
    "counter_hypothesis": {
      "type": "object",
      "additionalProperties": true
    },
    "negative_controls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "residual_uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "outcome": {
      "type": "string",
      "enum": ["SELF_REVIEW_PASS", "FAIL_CLOSED"]
    }
  }
}
