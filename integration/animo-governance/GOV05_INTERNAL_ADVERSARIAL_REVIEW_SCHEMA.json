{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GOV05_INTERNAL_ADVERSARIAL_REVIEW_SCHEMA.json",
  "title": "ANIMO GOV05 internal adversarial review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_unit",
    "risk_tier",
    "review_mode",
    "assurance_label",
    "reviewed_authoring_head",
    "same_agent",
    "independence_claimed",
    "review_boundary",
    "evidence_reuse_checks",
    "counter_hypothesis",
    "active_controls",
    "negative_controls",
    "scientific_gates",
    "adversarial_gates",
    "residual_uncertainty",
    "outcome"
  ],
  "properties": {
    "work_unit": {"type": "string", "minLength": 1},
    "risk_tier": {
      "type": "string",
      "enum": ["GOVERNANCE", "A", "B", "C", "D"]
    },
    "review_mode": {
      "type": "string",
      "enum": ["INTERNAL_ADVERSARIAL_REVIEW", "SAME_AGENT_SECOND_PASS"]
    },
    "assurance_label": {
      "type": "string",
      "enum": [
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT",
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_LOWER_THAN_GOV04_SEPARATE_CONTEXT",
        "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_MULTI_SURFACE"
      ]
    },
    "reviewed_authoring_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "same_agent": {"const": true},
    "independence_claimed": {"const": false},
    "review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_authoring_package_persisted",
        "immutable_head_frozen_before_review",
        "source_testbank_evidence_hashes_recorded_before_review",
        "authoring_completed_before_review",
        "authoring_head_matches_reviewed_head",
        "moving_tree_reviewed"
      ],
      "properties": {
        "complete_authoring_package_persisted": {"const": true},
        "immutable_head_frozen_before_review": {"const": true},
        "source_testbank_evidence_hashes_recorded_before_review": {"const": true},
        "authoring_completed_before_review": {"const": true},
        "authoring_head_matches_reviewed_head": {"const": true},
        "moving_tree_reviewed": {"const": false}
      }
    },
    "evidence_reuse_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_identity",
        "scope_compatibility",
        "immutable_provenance",
        "no_superseding_contradiction",
        "evidence_strength_preserved"
      ],
      "properties": {
        "pin_identity": {"const": "PASS"},
        "scope_compatibility": {"const": "PASS"},
        "immutable_provenance": {"const": "PASS"},
        "no_superseding_contradiction": {"const": "PASS"},
        "evidence_strength_preserved": {"const": "PASS"}
      }
    },
    "counter_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested", "alternative", "test", "result"],
      "properties": {
        "tested": {"const": true},
        "alternative": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "result": {
          "type": "string",
          "enum": [
            "ALTERNATIVE_REJECTED_BY_PINNED_EVIDENCE",
            "ALTERNATIVE_HAS_HIGHER_INDEPENDENCE_ASSURANCE_BUT_IS_NOT_REQUIRED_BY_GOV05",
            "ALTERNATIVE_REMAINS_PLAUSIBLE_FAIL_CLOSED",
            "CLAIM_FALSIFIED"
          ]
        }
      }
    },
    "active_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "scientific_gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicability", "result", "justification"],
        "properties": {
          "applicability": {
            "type": "string",
            "enum": ["APPLICABLE", "NOT_APPLICABLE"]
          },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]
          },
          "justification": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {"applicability": {"const": "APPLICABLE"}},
              "required": ["applicability"]
            },
            "then": {
              "properties": {"result": {"enum": ["PASS", "FAIL"]}}
            }
          },
          {
            "if": {
              "properties": {"applicability": {"const": "NOT_APPLICABLE"}},
              "required": ["applicability"]
            },
            "then": {
              "properties": {"result": {"const": "NOT_APPLICABLE"}}
            }
          }
        ]
      }
    },
    "adversarial_gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "FAIL"]
      }
    },
    "tier_c_enhanced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_authoring_checkpoint",
        "complete_source_state_ownership_reconstruction",
        "first_read_first_write_or_restore_direction_analysis",
        "counter_hypothesis_test",
        "active_controls",
        "negative_controls",
        "split_run_or_restart_evidence",
        "exact_comparison_policy",
        "no_invented_tolerance",
        "regression_guard",
        "regression_surface_declared",
        "exact_final_head_ci_required"
      ],
      "properties": {
        "immutable_authoring_checkpoint": {"const": "PASS"},
        "complete_source_state_ownership_reconstruction": {"const": "PASS"},
        "first_read_first_write_or_restore_direction_analysis": {"const": "PASS"},
        "counter_hypothesis_test": {"const": "PASS"},
        "active_controls": {"const": "PASS"},
        "negative_controls": {"const": "PASS"},
        "split_run_or_restart_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "result", "justification"],
          "properties": {
            "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
            "result": {"enum": ["PASS", "NOT_APPLICABLE"]},
            "justification": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"applicability": {"const": "APPLICABLE"}}, "required": ["applicability"]},
              "then": {"properties": {"result": {"const": "PASS"}}}
            },
            {
              "if": {"properties": {"applicability": {"const": "NOT_APPLICABLE"}}, "required": ["applicability"]},
              "then": {"properties": {"result": {"const": "NOT_APPLICABLE"}}}
            }
          ]
        },
        "exact_comparison_policy": {"type": "string", "minLength": 1},
        "no_invented_tolerance": {"const": true},
        "regression_guard": {"const": "PASS"},
        "regression_surface_declared": {"const": true},
        "exact_final_head_ci_required": {"const": true}
      }
    },
    "tier_d_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_surface",
        "surface_checkpoint_sha",
        "surface_not_collapsed",
        "ordinary_authoring_authorizes_production"
      ],
      "properties": {
        "decision_surface": {
          "enum": [
            "COMPOSITION_QUALIFICATION",
            "INTEGRATION_QUALIFICATION",
            "B4_DECISION",
            "PRODUCTION_AUTHORIZATION"
          ]
        },
        "surface_checkpoint_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "surface_not_collapsed": {"const": true},
        "ordinary_authoring_authorizes_production": {"const": false}
      }
    },
    "residual_uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "outcome": {
      "type": "string",
      "enum": ["SELF_REVIEW_PASS", "FAIL_CLOSED"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "SELF_REVIEW_PASS"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "adversarial_gates": {
            "additionalProperties": {"const": "PASS"}
          },
          "scientific_gates": {
            "additionalProperties": {
              "not": {
                "properties": {"result": {"const": "FAIL"}},
                "required": ["result"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"risk_tier": {"const": "B"}},
        "required": ["risk_tier"]
      },
      "then": {
        "properties": {
          "assurance_label": {"const": "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT"}
        }
      }
    },
    {
      "if": {
        "properties": {"risk_tier": {"const": "C"}},
        "required": ["risk_tier"]
      },
      "then": {
        "required": ["tier_c_enhanced"],
        "properties": {
          "assurance_label": {"const": "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_LOWER_THAN_GOV04_SEPARATE_CONTEXT"}
        }
      }
    },
    {
      "if": {
        "properties": {"risk_tier": {"const": "D"}},
        "required": ["risk_tier"]
      },
      "then": {
        "required": ["tier_d_surface"],
        "properties": {
          "assurance_label": {"const": "PROCESS_SELF_REVIEWED_NOT_INDEPENDENT_MULTI_SURFACE"}
        }
      }
    }
  ]
}
