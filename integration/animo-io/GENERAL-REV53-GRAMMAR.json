  },
  "lexical_semantics": {
    "Findadr": "REWIND, then sequential A8 reads until exact label equality; missing label sets Error=1995.",
    "ReadOp": "Consumes exactly one next record; compares prefix through first '='; list-directed INTEGER conversion from substring between first '=' and first '!'; mismatch sets 9870. PClassOption and HydroYearSwitch callers explicitly clear that error and assign 0.",
    "Readints": "Consumes exactly one next record; prefix-through-'=' check; list-directed INTEGER array conversion between '=' and '!'; mismatch sets 9870. Zero cardinality is treated as a bounded zero-element representation case only.",
    "Readvals": "Consumes exactly one next record; prefix-through-'=' check; list-directed default REAL array conversion between '=' and '!'; mismatch sets 9870; supplied project makes default REAL binary64.",
    "ReadTs": "Consumes exactly one next record; prefix-through-'=' check; first digit 0..3 in remaining 132-character record selects file/selected-compartment flags; mismatch normally sets 9871, except the two late optional whole-profile outputs which set jout=0 and Error=0 without defining the line-selector storage."
  },
  "normalized_representation": {
    "record_identity": ["field_id", "section", "sequence_index", "repeat_index"],
    "provenance": ["source_line", "lexical_form", "legacy_parser_path"],
    "presence_states": ["EXPLICIT", "DEFAULTED", "INACTIVE_NULL"],
    "typed_targets": ["ModelConfiguration", "SimulationWindow", "DiagnosticsConfiguration"],
    "not_a_free_order_property_bag": true,
    "no_blanket_numeric_tolerance": true,
    "round_trip_claim": "No byte round-trip identity claim. Semantic equivalence is by normalized parser projection plus preserved lexical/order provenance for admitted inputs."
  },
  "explicit_non_admissions": [
    "production input migration",
    "GENERAL grammar redesign or free ordering",
    "silent defaults not observed in revision-53 source",
    "GHGMais or generic GHG schema admission",
    "binary hydrology",
    "INITIAL or restart",
    "TTUTIL as scientific or numeric authority",
    "undefined legacy storage normalized to fabricated values"
  ]
