{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abhedwig-cell/ANIMO5/integration/animo-b3/B3_DISPOSITION_SCHEMA.json",
  "title": "ANIMO5 B3 Scientific Legacy Disposition Record",
  "description": "Fail-closed qualification contract for atomic B3 scientific legacy dispositions. Classification or test success alone does not constitute admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_version",
    "tcd_ids",
    "atomicity",
    "qualification_class",
    "admission_route",
    "disposition",
    "scope",
    "identities",
    "evidence",
    "class_specific_evidence",
    "gates",
    "residual_uncertainty",
    "composition",
    "admission_decision"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_version": {"type": "integer", "minimum": 1},
    "tcd_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TCD-[0-9]{3}$"}
    },
    "atomicity": {
      "enum": ["ATOMIC", "REQUIRES_ATOMIZATION"]
    },
    "qualification_class": {
      "enum": ["A", "B", "C", "D", "E", "F"]
    },
    "admission_route": {
      "enum": [
        "NORMAL_B2_AVAILABLE",
        "INDEPENDENT_SCIENTIFIC_ADMISSION_WITH_HISTORICAL_UNCERTAINTY"
      ]
    },
    "disposition": {
      "enum": [
        "PRESERVE_HISTORICAL_BEHAVIOUR",
        "ADMIT_CORRECTED_LEGACY_BEHAVIOUR",
        "REPRESENTATION_CHANGE_ONLY",
        "NUMERICAL_POLICY_CHANGE_REQUIRES_SEPARATE_QUALIFICATION",
        "PHYSICS_CHANGE_REQUIRES_SEPARATE_SCIENTIFIC_ADMISSION",
        "UNRESOLVED_NOT_ADMITTED",
        "HISTORICAL_BEHAVIOUR_UNKNOWN_SCIENTIFIC_ADMISSION_WITH_UNCERTAINTY"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "code_path", "claimed_change", "control_volume"],
      "properties": {
        "process": {"type": "string", "minLength": 1},
        "code_path": {"type": "string", "minLength": 1},
        "claimed_change": {"type": "string", "minLength": 1},
        "control_volume": {"type": "string", "minLength": 1}
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b0", "b1", "b2"],
      "properties": {
        "b0": {"$ref": "#/$defs/b0Identity"},
        "b1": {"$ref": "#/$defs/b1Identity"},
        "b2": {"$ref": "#/$defs/b2Identity"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theory",
        "causal",
        "conservation",
        "expected_difference",
        "non_interference",
        "coverage",
        "independent_review"
      ],
      "properties": {
        "theory": {"$ref": "#/$defs/evidenceBlock"},
        "causal": {"$ref": "#/$defs/evidenceBlock"},
        "conservation": {"$ref": "#/$defs/evidenceBlock"},
        "expected_difference": {"$ref": "#/$defs/expectedDifference"},
        "non_interference": {"$ref": "#/$defs/evidenceBlock"},
        "coverage": {"$ref": "#/$defs/coverageEvidence"},
        "independent_review": {"$ref": "#/$defs/reviewEvidence"},
        "historical_uncertainty": {"$ref": "#/$defs/historicalUncertainty"}
      }
    },
    "class_specific_evidence": {"type": "object"},
    "gates": {"$ref": "#/$defs/gates"},
    "residual_uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_composition", "component_record_ids"],
      "properties": {
        "is_composition": {"type": "boolean"},
        "component_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "composition_record_id": {"type": "string", "minLength": 1}
      }
    },
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "decision", "decision_scope"],
      "properties": {
        "admitted": {"type": "boolean"},
        "decision": {"type": "string", "minLength": 1},
        "decision_scope": {"type": "string", "minLength": 1},
        "decision_evidence_ref": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "b0Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "testcase_status", "documentation_or_theory_identity"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "testbank_sha256": {"$ref": "#/$defs/sha256"},
        "testcase_status": {
          "enum": ["FROZEN_CASE_IDENTIFIED", "NO_HISTORICAL_CASE_EXISTS", "HISTORICAL_CASE_UNKNOWN"]
        },
        "testcase_identity": {"type": "string", "minLength": 1},
        "documentation_or_theory_identity": {"type": "string", "minLength": 1}
      }
    },
    "b1Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_identity", "diagnostic_limitations"],
      "properties": {
        "status": {"const": "DIAGNOSTIC_NOT_REFERENCE"},
        "evidence_identity": {"type": "string", "minLength": 1},
        "diagnostic_limitations": {"type": "string", "minLength": 1}
      }
    },
    "b2Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE_QUALIFIED_REFERENCE",
            "UNAVAILABLE_AFTER_DOCUMENTED_ACQUISITION_ATTEMPT"
          ]
        },
        "reference_identity": {"type": "string", "minLength": 1},
        "path_relevance": {"type": "string", "minLength": 1},
        "acquisition_effort_ref": {"type": "string", "minLength": 1}
      }
    },
    "evidenceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "refs"],
      "properties": {
        "status": {"enum": ["PRESENT", "INSUFFICIENT", "NOT_APPLICABLE"]},
        "summary": {"type": "string", "minLength": 1},
        "refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expectedDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_states", "changed_fluxes", "changed_ledgers_or_reports", "unchanged_surfaces"],
      "properties": {
        "changed_states": {"type": "array", "items": {"type": "string"}},
        "changed_fluxes": {"type": "array", "items": {"type": "string"}},
        "changed_ledgers_or_reports": {"type": "array", "items": {"type": "string"}},
        "unchanged_surfaces": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["natural_case_coverage", "synthetic_case_coverage", "branch_activation_proven", "refs"],
      "properties": {
        "natural_case_coverage": {"type": "string", "minLength": 1},
        "synthetic_case_coverage": {"type": "string", "minLength": 1},
        "branch_activation_proven": {"type": "boolean"},
        "refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_or_workunit", "independent_from_correction_authoring", "scope", "result"],
      "properties": {
        "status": {"enum": ["COMPLETE", "INCOMPLETE"]},
        "reviewer_or_workunit": {"type": "string", "minLength": 1},
        "independent_from_correction_authoring": {"type": "boolean"},
        "scope": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL", "NOT_REVIEWED"]}
      }
    },
    "historicalUncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_effort_ref",
        "stopping_rationale",
        "scientific_basis_ref",
        "independent_cross_check_ref",
        "second_line_review_ref",
        "uncertainty_statement",
        "scope_limitations"
      ],
      "properties": {
        "acquisition_effort_ref": {"type": "string", "minLength": 1},
        "stopping_rationale": {"type": "string", "minLength": 1},
        "scientific_basis_ref": {"type": "string", "minLength": 1},
        "independent_cross_check_ref": {"type": "string", "minLength": 1},
        "second_line_review_ref": {"type": "string", "minLength": 1},
        "uncertainty_statement": {"type": "string", "minLength": 1},
        "scope_limitations": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "applicability", "justification", "evidence_refs"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
        "justification": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b0_identity",
        "b1_evidence",
        "b2_route",
        "theory",
        "causal",
        "conservation",
        "expected_difference",
        "non_interference",
        "coverage",
        "independent_review",
        "residual_uncertainty",
        "class_specific",
        "composition_if_applicable"
      ],
      "properties": {
        "b0_identity": {"$ref": "#/$defs/gate"},
        "b1_evidence": {"$ref": "#/$defs/gate"},
        "b2_route": {"$ref": "#/$defs/gate"},
        "theory": {"$ref": "#/$defs/gate"},
        "causal": {"$ref": "#/$defs/gate"},
        "conservation": {"$ref": "#/$defs/gate"},
        "expected_difference": {"$ref": "#/$defs/gate"},
        "non_interference": {"$ref": "#/$defs/gate"},
        "coverage": {"$ref": "#/$defs/gate"},
        "independent_review": {"$ref": "#/$defs/gate"},
        "residual_uncertainty": {"$ref": "#/$defs/gate"},
        "class_specific": {"$ref": "#/$defs/gate"},
        "composition_if_applicable": {"$ref": "#/$defs/gate"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"admission_route": {"const": "NORMAL_B2_AVAILABLE"}}},
      "then": {
        "properties": {
          "identities": {
            "properties": {
              "b2": {
                "required": ["reference_identity", "path_relevance"],
                "properties": {"status": {"const": "AVAILABLE_QUALIFIED_REFERENCE"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"admission_route": {"const": "INDEPENDENT_SCIENTIFIC_ADMISSION_WITH_HISTORICAL_UNCERTAINTY"}}},
      "then": {
        "properties": {
          "identities": {
            "properties": {
              "b2": {
                "required": ["acquisition_effort_ref"],
                "properties": {"status": {"const": "UNAVAILABLE_AFTER_DOCUMENTED_ACQUISITION_ATTEMPT"}}
              }
            }
          },
          "evidence": {"required": ["historical_uncertainty"]},
          "disposition": {
            "enum": [
              "ADMIT_CORRECTED_LEGACY_BEHAVIOUR",
              "REPRESENTATION_CHANGE_ONLY",
              "NUMERICAL_POLICY_CHANGE_REQUIRES_SEPARATE_QUALIFICATION",
              "PHYSICS_CHANGE_REQUIRES_SEPARATE_SCIENTIFIC_ADMISSION",
              "UNRESOLVED_NOT_ADMITTED",
              "HISTORICAL_BEHAVIOUR_UNKNOWN_SCIENTIFIC_ADMISSION_WITH_UNCERTAINTY"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "PRESERVE_HISTORICAL_BEHAVIOUR"}}},
      "then": {"properties": {"admission_route": {"const": "NORMAL_B2_AVAILABLE"}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "HISTORICAL_BEHAVIOUR_UNKNOWN_SCIENTIFIC_ADMISSION_WITH_UNCERTAINTY"}}},
      "then": {"properties": {"admission_route": {"const": "INDEPENDENT_SCIENTIFIC_ADMISSION_WITH_HISTORICAL_UNCERTAINTY"}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "REPRESENTATION_CHANGE_ONLY"}}},
      "then": {"properties": {"qualification_class": {"const": "D"}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "NUMERICAL_POLICY_CHANGE_REQUIRES_SEPARATE_QUALIFICATION"}}},
      "then": {
        "properties": {
          "qualification_class": {"const": "E"},
          "admission_decision": {"properties": {"admitted": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "PHYSICS_CHANGE_REQUIRES_SEPARATE_SCIENTIFIC_ADMISSION"}}},
      "then": {
        "properties": {
          "qualification_class": {"const": "F"},
          "admission_decision": {"properties": {"admitted": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "UNRESOLVED_NOT_ADMITTED"}}},
      "then": {"properties": {"admission_decision": {"properties": {"admitted": {"const": false}}}}}
    },
    {
      "if": {"properties": {"qualification_class": {"const": "A"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "physical_state_trajectory_unchanged",
              "process_flux_trajectory_unchanged",
              "intended_ledger_or_report_only",
              "conservation_identity_ref",
              "changed_reporting_surfaces",
              "unchanged_physical_surfaces"
            ],
            "properties": {
              "physical_state_trajectory_unchanged": {"const": true},
              "process_flux_trajectory_unchanged": {"const": true},
              "intended_ledger_or_report_only": {"const": true},
              "conservation_identity_ref": {"type": "string", "minLength": 1},
              "changed_reporting_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "unchanged_physical_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification_class": {"const": "B"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exact_causal_codepath", "mathematical_identity_ref", "affected_states_or_fluxes", "branch_coverage_ref", "historical_disagreement_recorded"],
            "properties": {
              "exact_causal_codepath": {"type": "string", "minLength": 1},
              "mathematical_identity_ref": {"type": "string", "minLength": 1},
              "affected_states_or_fluxes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "branch_coverage_ref": {"type": "string", "minLength": 1},
              "historical_disagreement_recorded": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification_class": {"const": "C"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theory_ref", "state_definition", "units", "owner", "initialization_semantics_ref", "restart_semantics_ref", "transition_semantics_ref", "conservation_identity_ref", "edge_case_coverage_ref", "independent_scientific_review_ref"],
            "properties": {
              "theory_ref": {"type": "string", "minLength": 1},
              "state_definition": {"type": "string", "minLength": 1},
              "units": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "initialization_semantics_ref": {"type": "string", "minLength": 1},
              "restart_semantics_ref": {"type": "string", "minLength": 1},
              "transition_semantics_ref": {"type": "string", "minLength": 1},
              "conservation_identity_ref": {"type": "string", "minLength": 1},
              "edge_case_coverage_ref": {"type": "string", "minLength": 1},
              "independent_scientific_review_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification_class": {"const": "D"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["admitted_b3_target_ref", "equivalence_evidence_ref", "state_flux_equivalence", "numerical_policy_unchanged", "process_ordering_unchanged"],
            "properties": {
              "admitted_b3_target_ref": {"type": "string", "minLength": 1},
              "equivalence_evidence_ref": {"type": "string", "minLength": 1},
              "state_flux_equivalence": {"const": true},
              "numerical_policy_unchanged": {"const": true},
              "process_ordering_unchanged": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification_class": {"const": "E"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["governing_equations_ref", "legacy_policy", "proposed_policy", "convergence_study_ref", "precision_sensitivity_ref", "conservation_study_ref", "trajectory_sensitivity_ref", "acceptance_criteria_derivation_ref", "independent_numerical_review_ref"],
            "properties": {
              "governing_equations_ref": {"type": "string", "minLength": 1},
              "legacy_policy": {"type": "string", "minLength": 1},
              "proposed_policy": {"type": "string", "minLength": 1},
              "convergence_study_ref": {"type": "string", "minLength": 1},
              "precision_sensitivity_ref": {"type": "string", "minLength": 1},
              "conservation_study_ref": {"type": "string", "minLength": 1},
              "trajectory_sensitivity_ref": {"type": "string", "minLength": 1},
              "acceptance_criteria_derivation_ref": {"type": "string", "minLength": 1},
              "independent_numerical_review_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualification_class": {"const": "F"}}},
      "then": {
        "properties": {
          "class_specific_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scientific_rationale_ref", "authoritative_theory_ref", "relation_to_b3_ref", "calibration_implications_ref", "validation_evidence_ref", "independent_scientific_review_ref"],
            "properties": {
              "scientific_rationale_ref": {"type": "string", "minLength": 1},
              "authoritative_theory_ref": {"type": "string", "minLength": 1},
              "relation_to_b3_ref": {"type": "string", "minLength": 1},
              "calibration_implications_ref": {"type": "string", "minLength": 1},
              "validation_evidence_ref": {"type": "string", "minLength": 1},
              "independent_scientific_review_ref": {"type": "string", "minLength": 1}
            }
          },
          "admission_decision": {
            "properties": {"admitted": {"const": false}}
          },
          "disposition": {
            "enum": ["PHYSICS_CHANGE_REQUIRES_SEPARATE_SCIENTIFIC_ADMISSION", "UNRESOLVED_NOT_ADMITTED"]
          }
        }
      }
    },
    {
      "if": {"properties": {"composition": {"properties": {"is_composition": {"const": true}}}}},
      "then": {
        "properties": {
          "composition": {
            "required": ["composition_record_id"],
            "properties": {"component_record_ids": {"minItems": 2}}
          }
        }
      },
      "else": {
        "properties": {
          "composition": {
            "properties": {"component_record_ids": {"maxItems": 0}}
          }
        }
      }
    },
    {
      "if": {"properties": {"admission_decision": {"properties": {"admitted": {"const": true}}}},
      "then": {
        "properties": {
          "atomicity": {"const": "ATOMIC"},
          "disposition": {
            "enum": [
              "PRESERVE_HISTORICAL_BEHAVIOUR",
              "ADMIT_CORRECTED_LEGACY_BEHAVIOUR",
              "REPRESENTATION_CHANGE_ONLY",
              "HISTORICAL_BEHAVIOUR_UNKNOWN_SCIENTIFIC_ADMISSION_WITH_UNCERTAINTY"
            ]
          },
          "gates": {
            "properties": {
              "b0_identity": {"properties": {"status": {"const": "PASS"}}},
              "b1_evidence": {"properties": {"status": {"const": "PASS"}}},
              "b2_route": {"properties": {"status": {"const": "PASS"}}},
              "theory": {"properties": {"status": {"const": "PASS"}}},
              "causal": {"properties": {"status": {"const": "PASS"}}},
              "conservation": {"properties": {"status": {"const": "PASS"}}},
              "expected_difference": {"properties": {"status": {"const": "PASS"}}},
              "non_interference": {"properties": {"status": {"const": "PASS"}}},
              "coverage": {"properties": {"status": {"const": "PASS"}}},
              "independent_review": {"properties": {"status": {"const": "PASS"}}},
              "residual_uncertainty": {"properties": {"status": {"const": "PASS"}}},
              "class_specific": {"properties": {"status": {"const": "PASS"}}},
              "composition_if_applicable": {"properties": {"status": {"const": "PASS"}}}
            }
          }
        }
      }
    }
  ],
  "x-class-contracts": {
    "A": {
      "name": "ACCOUNTING_REPORTING_ONLY",
      "admission_test": "physical state and process flux trajectories unchanged; only intended ledger/report surfaces change; conservation/report identity restored"
    },
    "B": {
      "name": "LOCAL_ALGEBRA_INDEX_SPECIES",
      "admission_test": "exact causal path and mathematical identity proven; affected state/flux differences declared; branch coverage, conservation and non-interference qualified"
    },
    "C": {
      "name": "MISSING_PHYSICAL_STATE_OR_INCOMPLETE_STATE_MODEL",
      "admission_test": "authoritative state theory, ownership, initialization, restart, transitions and conservation qualified in a dedicated scientific workunit"
    },
    "D": {
      "name": "REPRESENTATION_ONLY_MODERNIZATION",
      "admission_test": "equivalence to an already admitted B3 target with unchanged equations, numerical policy and process ordering"
    },
    "E": {
      "name": "NUMERICAL_POLICY_CHANGE",
      "admission_test": "governing equations, convergence, precision, conservation and trajectory sensitivity independently qualified; balance improvement alone is insufficient"
    },
    "F": {
      "name": "PHYSICS_MODEL_EVOLUTION",
      "admission_test": "not admitted as corrected legacy under this schema; requires separate scientific admission unless reclassified after proof of authoritative intended-theory implementation error"
    }
  },
  "x-route-contracts": {
    "NORMAL_B2_AVAILABLE": {
      "b2_required": true,
      "historical_behaviour_known_within_exercised_scope": true
    },
    "INDEPENDENT_SCIENTIFIC_ADMISSION_WITH_HISTORICAL_UNCERTAINTY": {
      "b2_required": false,
      "documented_failed_acquisition_required": true,
      "independent_cross_check_required": true,
      "second_line_review_required": true,
      "historical_behaviour_must_remain_explicitly_unknown": true,
      "cannot_waive": ["poorly documented physics", "arbitrary numerical tolerance", "broad numerical-policy change"]
    }
  },
  "x-fail-closed": {
    "missing_required_field": "NOT_ADMITTED",
    "failed_gate": "NOT_ADMITTED",
    "unresolved_atomicity": "NOT_ADMITTED",
    "test_pass_without_qualification": "NOT_ADMITTED",
    "b1_used_as_b2": "NOT_ADMITTED",
    "synthetic_case_used_as_historical_reference": "NOT_ADMITTED",
    "composition_without_separate_record": "NOT_ADMITTED",
    "non_admission_disposition_with_admitted_true": "SCHEMA_INVALID"
  }
}
