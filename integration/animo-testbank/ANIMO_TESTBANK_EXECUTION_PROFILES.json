      "may_define_expected_result": false
    },
    "volatile_output_normalization": {
      "default_allowed": false,
      "requires_explicit_allowlist": true
    }
  },
  "reuse_policy": {
    "mode": "VERIFY_AND_REUSE",
    "immutable_expensive_evidence_rerun_without_reason": false,
    "reuse_requires_matching_source_identity": true,
    "reuse_requires_matching_input_identity": true,
    "reuse_requires_matching_or_stronger_comparison_policy": true,
    "reuse_requires_applicability_predicates": true,
    "changed_dependency_invalidates_reuse_until_requalified": true,
    "automated_green_result_can_override_unresolved_scientific_interpretation": false
  },
  "parallel_execution_contract": {
