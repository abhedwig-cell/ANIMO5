  "gate_requirements": [
    {
      "gate": "ORDINARY_DEVELOPMENT",
      "required_profiles": ["DEVELOPER_FAST"],
      "conditional_profiles": ["SCIENTIFIC_FOCUSED"],
      "condition": "Focused profile is required when a changed surface has a registered scientific or subsystem obligation."
    },
    {
      "gate": "TCD_READINESS",
      "required_profiles": ["DEVELOPER_FAST", "SCIENTIFIC_FOCUSED"],
      "conditional_profiles": ["DEEP_AUDIT"],
      "condition": "Deep audit is risk-triggered, not a universal rereun."
    },
    {
      "gate": "GOV05_SINGLE_AGENT_ADVERSARIAL_REVIEW",
      "required_profiles": ["SCIENTIFIC_FOCUSED"],
      "conditional_profiles": ["ADMISSION_QUALIFICATION", "DEEP_AUDIT"],
      "evidence_resolution_mode": "VERIFY_AND_REUSE",
      "workflow": [
        "identify claim",
        "resolve required ATB test IDs",
        "verify immutable test and evidence pins",
        "execute only missing, invalidated or newly applicable gates",
        "adversarially inspect failures, controls and alternative hypotheses",
        "record review decision"
      ],
      "assurance_note": "GOV05 same-agent adversarial review is PROCESS_SELF_REVIEWED_NOT_INDEPENDENT and must never be described as genuinely independent.",
      "green_automation_substitutes_for_unresolved_scientific_meaning": false
    },
    {
      "gate": "ATOMIC_B3_ADMISSION",
      "required_profiles": ["ADMISSION_QUALIFICATION"],
      "conditional_profiles": ["DEEP_AUDIT"],
      "requires_separate_scientific_admission_authority": true,
      "opened_by_tb01": false
    },
    {
      "gate": "COMPOSITION",
      "required_profiles": ["CANONICAL_BROAD", "ADMISSION_QUALIFICATION"],
      "conditional_profiles": ["DEEP_AUDIT"],
      "requires_separate_composition_authority": true,
      "opened_by_tb01": false
    },
    {
      "gate": "B4",
      "required_profiles": ["CANONICAL_BROAD", "ADMISSION_QUALIFICATION"],
      "conditional_profiles": ["DEEP_AUDIT", "RELEASE"],
      "availability": "CLOSED",
      "opened_by_tb01": false
    },
    {
      "gate": "PRODUCTION_RELEASE",
      "required_profiles": ["RELEASE"],
      "conditional_profiles": ["DEEP_AUDIT"],
      "availability": "CLOSED",
      "opened_by_tb01": false
    }
  ],
  "qualification_evidence_receipt": {
    "required_fields": [
      "source_head",
      "source_tree",
      "compiler_or_tool_identity",
      "testbank_manifest_identity",
      "testcase_and_input_hashes",
