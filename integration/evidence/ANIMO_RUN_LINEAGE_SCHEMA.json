{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abhedwig-cell/ANIMO5/integration/evidence/ANIMO_RUN_LINEAGE_SCHEMA.json",
  "title": "ANIMO5 run lineage record",
  "description": "Machine-readable provenance required for persisted runs that may influence ANIMO5 evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "output_evidence_class",
    "source_lineage",
    "input_lineage",
    "execution",
    "repository_context",
    "outputs",
    "qualification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "output_evidence_class": {
      "type": "string",
      "enum": ["DIAGNOSTIC_OUTPUT", "REFERENCE_OUTPUT", "CORRECTED_LEGACY", "MIGRATED_ANIMO5"]
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_or_descendant_id", "sha256", "class"],
      "properties": {
        "evidence_or_descendant_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "class": {
          "type": "string",
          "enum": ["B0_RAW_IMMUTABLE", "WORKING_COPY", "COMPATIBILITY_TRANSFORM", "CORRECTED_LEGACY", "MIGRATED_ANIMO5"]
        },
        "parent_b0_evidence_id": {"type": ["string", "null"]},
        "compatibility_transform_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "input_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_or_descendant_id", "sha256", "role", "class"],
        "properties": {
          "evidence_or_descendant_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1},
          "class": {
            "type": "string",
            "enum": ["B0_RAW_IMMUTABLE", "B0_MANIFEST", "WORKING_COPY", "COMPATIBILITY_TRANSFORM"]
          },
          "parent_b0_evidence_id": {"type": ["string", "null"]},
          "compatibility_transform_id": {"type": ["string", "null"]}
        }
      }
    },
    "documentation_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "use"],
        "properties": {
          "evidence_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "use": {"type": "string"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_or_interpreter", "environment", "test_selector"],
      "properties": {
        "executable_or_interpreter": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "compiler_or_build_tool": {"type": ["string", "null"]},
        "compiler_version": {"type": ["string", "null"]},
        "build_flags": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "string", "minLength": 1},
        "test_selector": {"type": "string", "minLength": 1},
        "execution_timestamp": {"type": ["string", "null"]},
        "configuration_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"const": "abhedwig-cell/ANIMO5"},
        "branch": {"type": ["string", "null"]},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "sha256"],
        "properties": {
          "logical_name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "output_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_admitted"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "reference_admitted": {"type": "boolean"},
        "qualification_gate": {"type": ["string", "null"]},
        "known_deviations": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "unresolved_provenance_gaps": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"output_evidence_class": {"const": "REFERENCE_OUTPUT"}}},
      "then": {
        "properties": {
          "qualification": {
            "properties": {"reference_admitted": {"const": true}},
            "required": ["qualification_gate"]
          }
        }
      }
    }
  ]
}
